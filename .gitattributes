# Preserve native artifacts and byte-exact historical sources.
*.mlx binary
*.mp4 binary
*.png binary
*.pptx binary
"PROJECT/Dynamic Model/Ensayos/*.m" -text whitespace=-trailing-space,-blank-at-eof
"PROJECT/Hybrid Tests/*.m" -text whitespace=-trailing-space,-blank-at-eof
"PROJECT/Results/Run_Sources/*.m" -text whitespace=-trailing-space,-blank-at-eof
# Exports keep historical whitespace; new documentation uses portable LF.
"PROJECT/Dynamic Model/Source Exports/*.m" text eol=lf whitespace=-trailing-space,-blank-at-eof
"PROJECT/Hybrid Tests/Source Exports/*.m" text eol=lf whitespace=-trailing-space,-blank-at-eof
"Trajectory Tracking/Source Exports/*.m" text eol=lf whitespace=-trailing-space,-blank-at-eof
"PROJECT/Tools/*.m" text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.py text eol=lf
